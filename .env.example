# Client-safe Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for username lookup during login; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only provider credentials
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only set after configuring a real GIS dataset and its attribution.
NEXT_PUBLIC_BOUNDARY_GEOJSON_URL=

# Optional MapLibre style URL from a tile provider (for example, a provider-hosted style with its public browser key). Leave empty to use OpenStreetMap standard tiles.
NEXT_PUBLIC_MAP_STYLE_URL=
